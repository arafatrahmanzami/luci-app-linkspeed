config linkspeed 'config'
	option interface 'wan'
	
	# China Mainland Nodes
	list cn_url 'https://mirrors.aliyun.com/ubuntu-releases/24.04/ubuntu-24.04.1-live-server-amd64.iso'
	list cn_url 'https://mirrors.tuna.tsinghua.edu.cn/ubuntu-releases/24.04/ubuntu-24.04.1-live-server-amd64.iso'
	list cn_url 'https://mirrors.ustc.edu.cn/ubuntu-releases/24.04/ubuntu-24.04.1-live-server-amd64.iso'

	# Global Nodes (Clean list: No duplicates, no DXB)
	list global_url 'http://hkg.download.datapacket.com/100mb.bin'
	list global_url 'http://tyo.download.datapacket.com/100mb.bin'
	list global_url 'http://sgp.download.datapacket.com/100mb.bin'
	list global_url 'http://syd.download.datapacket.com/100mb.bin'
	list global_url 'http://lon.download.datapacket.com/100mb.bin'
	list global_url 'http://fra.download.datapacket.com/100mb.bin'
	list global_url 'https://nbg1-speed.hetzner.com/100MB.bin'
	list global_url 'https://gra.proof.ovh.net/files/100Mb.dat'
	list global_url 'http://cachefly.cachefly.net/100mb.test'

	# Upload URLs
	option cn_upload_url 'https://speed.cloudflare.com/__up'
	option global_upload_url 'https://speed.cloudflare.com/__up'
	
	# Defaults
	option duration '15'
	option max_megabytes '1000'
	option history_limit '20'
