config linkspeed 'config'
	option interface 'wan'
	
	# China Mainland Nodes
	list cn_url 'https://mirrors.aliyun.com/ubuntu-releases/24.04/ubuntu-24.04.1-live-server-amd64.iso'
	list cn_url 'https://mirrors.tuna.tsinghua.edu.cn/ubuntu-releases/24.04/ubuntu-24.04.1-live-server-amd64.iso'
	
	# Global Nodes (Verified Direct Files)
	list global_url 'https://speed.cloudflare.com/__down?during=download&bytes=104857600'
	list global_url 'https://nbg1-speed.hetzner.com/100MB.bin'
	list global_url 'http://speedtest.tele2.net/100MB.zip'
	list global_url 'http://mirror.bakertelekom.fr/speedtest/1GB.bin'
	list global_url 'https://sgp-ping.vultr.com/vultr.com.100MB.bin'
	list global_url 'https://sgp.proof.ovh.net/files/100Mb.dat'

	# Custom Verified Backends (Asia & Global)
	list custom_url 'http://hkg.download.datapacket.com/100mb.bin'
	list custom_url 'http://sgp.download.datapacket.com/100mb.bin'
	list custom_url 'http://tyo.download.datapacket.com/100mb.bin'
	list custom_url 'https://fra-de-ping.vultr.com/vultr.com.100MB.bin'
	list custom_url 'https://nbg1-speed.hetzner.com/100MB.bin'

	# Upload URLs
	option cn_upload_url 'https://test.nju.edu.cn/backend/empty.php'
	option global_upload_url 'https://speed.cloudflare.com/__up'
	
	# Defaults
	option duration '15'
	option max_megabytes '1000'
	option history_limit '20'
