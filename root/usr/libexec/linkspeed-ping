#!/bin/sh
URL="$1"
COUNT="${2:-5}"
if [ -z "$URL" ]; then echo "0|0|0|0"; exit 1; fi

HOST=$(echo "$URL" | awk -F/ '{print $3}')
UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# 1. Try ICMP ping first
PING_OUT=$(ping -c "$COUNT" -W 2 "$HOST" 2>/dev/null)
if [ $? -eq 0 ]; then
    # Extract min/avg/max (fields 5, 6, 7)
    MIN=$(echo "$PING_OUT" | awk -F '[/= ]+' '/min\/avg\/max/ {print $5}')
    AVG=$(echo "$PING_OUT" | awk -F '[/= ]+' '/min\/avg\/max/ {print $6}')
    MAX=$(echo "$PING_OUT" | awk -F '[/= ]+' '/min\/avg\/max/ {print $7}')
    
    if [ -n "$MIN" ] && [ -n "$AVG" ] && [ -n "$MAX" ]; then
        # Calculate Jitter = Max - Min
        JITTER=$(awk -v mx="$MAX" -v mn="$MIN" 'BEGIN {printf "%.1f", mx - mn}')
        echo "$MIN|$AVG|$MAX|$JITTER"
        exit 0
    fi
fi

# 2. TCP Fallback - Measure multiple times to get real variance
times=""
for i in $(seq 1 "$COUNT"); do
    T=$(curl -s -L -A "$UA" --range 0-0 -o /dev/null --connect-timeout 15 -w "%{time_connect}" "$URL" 2>/dev/null | tr -d '\r\n')
    if [ -n "$T" ] && [ "$T" != "0.000000" ]; then
        MS=$(awk -v t="$T" 'BEGIN {printf "%.0f", t * 1000}')
        times="$times $MS"
    fi
done

# 3. Calculate real stats from the TCP samples
if [ -n "$times" ]; then
    echo $times | awk '{
        min=$1; max=$1; sum=0;
        for (i=1; i<=NF; i++) {
            if ($i < min) min = $i;
            if ($i > max) max = $i;
            sum += $i;
        }
        avg = sum / NF;
        jitter = max - min;
        printf "%d|%d|%d|%d\n", min, avg, max, jitter;
    }'
    exit 0
fi

echo "0|0|0|0"
